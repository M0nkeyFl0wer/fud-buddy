# Copy to .env in this directory (or project root)
# OpenRouter API key (optional if using Ollama locally)
OPENROUTER_API_KEY=

# Ollama settings (defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Rate limit per client per day
RATE_LIMIT_DAILY=50

# Server port
PORT=8000
